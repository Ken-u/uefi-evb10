# Copy to .env and fill in. .env is git-ignored.

# --- Firmware build (build.sh) ---------------------------------------------------------------
# edk2-rk3588 checkout (https://github.com/edk2-porting/edk2-rk3588, submodules initialised,
# including edk2/MdePkg/Library/BaseFdtLib/libfdt)
UPSTREAM=
# UniXNU checkout, f85b5a6 or newer (provides package/UniXNUPkg and drivers/DarwinBoot)
UNIXNU=
# clang 20 bin directory with a trailing slash (edk2 CLANGDWARF toolchain)
CLANG_BIN=
# clang/llvm tools without the trailing slash (stub build, tests)
LLVM_BIN=

# --- Device tree for the firmware (tools/build-evb10-dtb.sh) ---------------------------------
# A Rockchip kernel 6.12 tree that contains arch/arm64/boot/dts/rockchip/rk3588-evb10-v10-linux.dts
KERNEL_TREE=

# --- Boot image (tools/board/mk-bootimg.sh, make-payload-boot.sh) ----------------------------
# mkbootimg (AOSP), the board's Rockchip resource.img (second stage with the dtb) and its dtb
MKBOOTIMG=
SECOND=
BOARD_DTB=
# UniXNU-evb10 checkout, MaliMetal checkout (GPU add-on, trust-bundle helper)
DEVICE_DIR=
MALIMETAL_DIR=
# unique chip id used for the payload (hex), and an optional prefix command for the payload build
UNIQUE_CHIP_ID=
#UNIXNU_WRAP=
# mtools directory when it is not on PATH
#MTOOLS_BIN=

# --- Board host (the machine the board is physically connected to) ----------------------------
# ssh target, e.g. user@host; key authentication is expected, never put a password in this file
BOARD_HOST=
# Directory of the ESP32-S3 reset controller tool on the board host (tools/device.py inside)
RESET_TOOL_DIR=
RESET_DIR=
# adb and fastboot on the board host (default: from PATH)
#ADB=
#FB=

# --- Optional -----------------------------------------------------------------------------------
# Where generated trust bundles and Data seeds go (default ./artifacts), run logs (default ./runs)
#ARTIFACTS=
#RUNS_DIR=
# linux-apfs/apfsprogs checkout (tools/xnu-probe/make-data-seed.sh builds mkapfs from it)
APFSPROGS=

# iasl (ACPICA) is needed for the DSDT; put it on PATH here if it is not installed system-wide, e.g.
#PATH=/path/to/acpica/generate/unix/bin:$PATH

# iasl (ACPICA) is needed for the DSDT; put it on PATH here if it is not installed system-wide, e.g.
#PATH=/path/to/acpica/generate/unix/bin:$PATH
