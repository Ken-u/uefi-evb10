#
#**/

[Defines]
  INF_VERSION                    = 0x0001001A
  BASE_NAME                      = DeviceTree-Vendor
  # Same FILE_GUID as the upstream Vendor.inf on purpose: FdtPlatformDxe and
  # PlatformGetDtbFileGuid look the blob up by GUID, and UniXNU/ROCK 5B users
  # already have tooling keyed on this one. Only one Vendor.inf is linked into
  # a given platform, so there is no clash.
  FILE_GUID                      = d58b4028-43d8-4e97-87d4-4e3716136580
  MODULE_TYPE                    = USER_DEFINED
  VERSION_STRING                 = 1.0

[Binaries]
  BIN|rk3588-evb10-v10.dtb
